<Project Sdk="Microsoft.NET.Sdk">

  <!--
    仅用于编译验证 Unity 适配层的临时工程：把资源系统源码、其依赖的 Network/Log 源码与 Unity 侧适配源码
    一起编译，引用本机 Unity 编辑器 (与 ProjectVersion 一致) 的 UnityEngine 模块程序集。
    只引用需要的模块：同时引用 UnityEngine.dll 会与 CoreModule 重复定义 Object 等类型。
    托管程序集只用于编译期校验 API 用法；真正运行仍需项目自身的 Unity 版本。
    它不属于交付物，也不被 ToolKit/Tests 引用。
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityManaged>D:\Unity\6000.6.7f1\Editor\Data\Managed</UnityManaged>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)Unity\Assets\ToolKit\Tools\Common\ResourceSystem\**\*.cs" />
    <Compile Include="$(RepoRoot)Unity\Assets\ToolKit\Tools\Common\Log\**\*.cs" />
    <Compile Include="$(RepoRoot)Unity\Assets\ToolKit\Tools\Network\**\*.cs" />
    <Compile Include="$(RepoRoot)Unity/Assets/UnityToolKit/Runtime/ResourceSystem/ResourcesLoader.cs" />
    <Compile Include="$(RepoRoot)Unity/Assets/UnityToolKit/Runtime/ResourceSystem/ToolKitResourceAdapters.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
